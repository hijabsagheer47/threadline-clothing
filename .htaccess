# ============================================================================
# TayyabaCollective — Apache configuration
# Pretty URLs, security hardening and error pages
# ============================================================================

# mod_rewrite refuses to apply a substitution unless FollowSymLinks is on.
# Without it the deny-only ([F]) rules still fire, which makes the breakage
# look like a routing bug rather than a missing option.
Options -Indexes +FollowSymLinks
ServerSignature Off

# Leftover static index.html files from the pre-PHP site must never win over
# the PHP storefront when a directory is requested.
DirectoryIndex index.php index.html

# The mobile API front controller reads its route from PATH_INFO
# (/api/v1/index.php/products). This host drops mod_rewrite substitutions, so
# PATH_INFO -- not a rewrite -- is what gives the API clean URLs.
AcceptPathInfo On

<IfModule mod_rewrite.c>
    RewriteEngine On

    # The domain is served from a sub-directory of the webspace, so a relative
    # substitution resolves against that path and 404s -- RewriteBase alone did
    # not fix it here. Every target below is therefore an absolute URL path.
    # Deny-only ([F]) rules need no target, which is why the protection rules
    # kept working and hid this.
    RewriteBase /

    # --- Mobile API --------------------------------------------------------
    # PHP-CGI and FastCGI strip the Authorization header before PHP sees it,
    # which would make every bearer token look missing. Copy it into an
    # environment variable the API reads as a fallback. This must come before
    # the [L] rules below, or it never runs for API requests.
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

    # Everything under /api/v1/ goes to one front controller. The matched path
    # travels as _route because REQUEST_URI is not reliable on every
    # IONOS/Apache configuration. !-f keeps the rewritten /api/v1/index.php
    # from matching itself on the second pass.
    # Placed before the pretty URLs so an API path never falls through to the
    # storefront routes below.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/v1/?(.*)$ /api/v1/index.php?_route=$1 [L,QSA]

    # --- Pretty URLs -------------------------------------------------------
    # /product/{slug}  ->  product.php?slug={slug}
    RewriteRule ^product/([a-zA-Z0-9\-]+)/?$ /product.php?slug=$1 [L,QSA]

    # /category/{slug} ->  category.php?slug={slug}
    RewriteRule ^category/([a-zA-Z0-9\-]+)/?$ /category.php?slug=$1 [L,QSA]

    # /collection/{slug} ->  collection.php?slug={slug}
    RewriteRule ^collection/([a-zA-Z0-9\-]+)/?$ /collection.php?slug=$1 [L,QSA]

    # /admin            ->  /admin/index.php
    RewriteRule ^admin/?$ /admin/index.php [L,QSA]
</IfModule>

# --- Protect sensitive directories ------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Dot-files and dot-directories (.git, tooling caches, editor state) are
    # never site content, and a stray one had been reachable. .well-known must
    # stay open -- certificate renewal is validated through it.
    RewriteRule ^\.well-known/ - [L]
    RewriteRule (^|/)\. - [F,L]

    RewriteRule ^config(/|$) - [F,L]
    RewriteRule ^includes(/|$) - [F,L]
    RewriteRule ^scripts(/|$) - [F,L]
    # Only the API front controller is reachable; its internals are includes.
    RewriteRule ^api/v1/routes(/|$) - [F,L]
    RewriteRule ^api/v1/(bootstrap|helpers)\.php$ - [F,L]
    RewriteRule ^(database\.sql|migration-fashlab-upgrade\.sql|migration-mobile-api\.sql|SETUP\.md|README\.md|DEPLOY\.md|API\.md)$ - [F,L]
</IfModule>

# --- Uploads: never execute scripts -----------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.(php|phtml|php3|php4|php5|php7|phar|pl|py|cgi|sh)$ - [F,L]
</IfModule>

# --- Error pages -------------------------------------------------------------
ErrorDocument 403 /403.php
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php

# --- Basic security headers --------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # The Postman collection is meant to be saved, not read in the browser.
    # Served as application/json it opens in Chrome's JSON viewer instead, and
    # the link's download attribute is not enough on its own -- this makes it
    # download however it is reached.
    # openapi.json deliberately has no such header: Swagger UI fetches it.
    <Files "Fashlab-API.postman_collection.json">
        Header set Content-Disposition "attachment; filename=\"Fashlab-API.postman_collection.json\""
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

# --- Caching for static assets ------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>