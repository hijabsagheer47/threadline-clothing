{
  "info": {
    "name": "Fashlab Studio \u2014 Customer API v1",
    "description": "Customer-side API for the Flutter app.\n\n**There are no customer accounts.** The app mirrors the website: browse, fill in the checkout form, order as a guest. The only login anywhere is the admin panel on the website, which this API does not expose.\n\nRun **Session > Device token** first: it saves the token into the `token` variable and every other request picks it up. The token is not a credential \u2014 it just carries the cart and wishlist.\n\n**Base URL note:** this webspace drops mod_rewrite substitutions, so the API routes on PATH_INFO \u2014 `baseUrl` ends in `/index.php` and paths hang off it (`.../index.php/products`). The query-string form `.../index.php?_route=products` works everywhere.\n\nIf `Authorization` is stripped by a host, send the token in `X-Api-Token` instead.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// The API re-issues a token whenever the one sent is missing or stale,",
          "// and returns it in X-Api-Token. Keep ours in step.",
          "const issued = pm.response.headers.get('X-Api-Token');",
          "if (issued) { pm.collectionVariables.set('token', issued); }",
          "",
          "let body;",
          "try { body = pm.response.json(); } catch (e) { body = null; }",
          "if (body && body.data) {",
          "    if (body.data.token) { pm.collectionVariables.set('token', body.data.token); }",
          "    if (body.data.items && body.data.items.length && body.data.items[0].slug) {",
          "        pm.collectionVariables.set('productSlug', body.data.items[0].slug);",
          "    }",
          "    if (body.data.product && body.data.product.slug) {",
          "        pm.collectionVariables.set('productSlug', body.data.product.slug);",
          "    }",
          "    if (body.data.items && body.data.items.length && body.data.items[0].key) {",
          "        pm.collectionVariables.set('cartKey', body.data.items[0].key);",
          "    }",
          "    if (body.data.order && body.data.order.order_number) {",
          "        pm.collectionVariables.set('orderNumber', body.data.order.order_number);",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://fashlabstudio.mytechrcm.com/api/v1/index.php"
    },
    {
