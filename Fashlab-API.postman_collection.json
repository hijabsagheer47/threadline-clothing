        {
          "name": "Place an order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Guest checkout, exactly like the website: fill in the form and order. There is no account.\n\nPrices, shipping and the coupon are recalculated server-side \u2014 anything the client sends about money is ignored.\n\n**Keep `order_number` from the response.** With no account, that number plus the email or phone is the only way back to the order.\n\n**Payment is Cash on Delivery only.** No gateway is connected, so a card order could never be settled.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ayesha Khan\",\n  \"email\": \"ayesha@example.com\",\n  \"phone\": \"03001234567\",\n  \"address\": \"House 12, Street 4, DHA Phase 5\",\n  \"city\": \"Karachi\",\n  \"postal_code\": \"75500\",\n  \"notes\": \"Please call before delivery\",\n  \"delivery\": \"standard\",\n  \"country\": \"Pakistan\",\n  \"is_gift\": false,\n  \"gift_message\": \"Happy birthday!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Track an order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/track",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "track"
              ]
            },
            "description": "`contact` must be the email or phone used on the order. Requiring it is what stops an order number on its own from exposing someone's address.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_number\": \"{{orderNumber}}\",\n  \"contact\": \"ayesha@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Look up an order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderNumber}}?contact=ayesha@example.com",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderNumber}}"
              ],
              "query": [
                {
                  "key": "contact",
                  "value": "ayesha@example.com",
                  "description": "Email or phone used on the order"
                }
              ]
            },
            "description": "The same lookup as `/orders/track`, for deep links and for polling an order just placed. `contact` is required for the same reason."
          }
        }
      ]
